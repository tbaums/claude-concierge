#!/bin/zsh
# ───────────────────────────────────────────────────────────────────────────
#  concierge — open a fresh "Claude Concierge" iTerm window (neon theme, fun
#  font, badge watermark) running Claude Code inside the tuned tmux session.
#
#  Just say / type:  concierge
#
#  Flags:
#    --new    start a brand-new conversation instead of resuming the last one
#    --here   launch in the CURRENT terminal window (no new iTerm window / no
#             profile theming — useful over SSH or in a plain shell)
#
#  Subcommands:
#    snapshot  capture the live socket (sessions, cwds, models, flags, splits,
#              dash grids) to ~/.config/claude-concierge/session-manifest.
#              Runs right here in this terminal — no window is opened.
#    restore   bring that working set back — everything absent, or named
#              sessions / a named --dash. Also --list, --dry-run, --force.
#              On demand only: nothing is ever restored for you.
#    backup status  health of the ~/.claude skills/memory/settings backup
#              (CONCIERGE_BACKUP_REPO): agent loaded, last-commit age,
#              unpushed commits, staleness.
#    unread    sessions whose Claude turn finished and you haven't focused
#              since: oldest first, with age and last line.
#    next      jump to the oldest unread session (prints its name when run
#              outside a tmux client).
#    ack <session> | --all   mark read without focusing.
#    version   print the installed version (version, --version, -V).
#    help      print the flags and subcommands (help, --help, -h).
#
#  Anything else is an error (exit 2) and opens no window.
#
#  By default the concierge resumes your previous conversation, so a crash or
#  reboot picks up exactly where you left off.
# ───────────────────────────────────────────────────────────────────────────

CFG="$HOME/.config/claude-concierge"

# The header above, in short. Kept in step with it by hand.
usage() {
  cat <<'USAGE'
usage: concierge [--new] [--here] | <subcommand> … | help

Flags (open the concierge window):
  --new        start a brand-new conversation instead of resuming the last one
  --here       launch in the current terminal window (no new iTerm window)

Subcommands (run here, never open a window):
  snapshot     capture the live socket to ~/.config/claude-concierge/session-manifest
  restore      bring that working set back (--list, --dry-run, --force, names, --dash)
  backup status  health of the ~/.claude skills/memory/settings backup
  unread       sessions whose Claude turn finished and you haven't focused since
  next         jump to the oldest unread session
  ack <session> | --all   mark read without focusing
  version      print the installed version
  help         print this help
USAGE
}

case "${1-}" in
  version|--version|-V)
    if [[ -r "$CFG/VERSION" ]]; then
      cat "$CFG/VERSION"; exit 0
    fi
    print -u2 "concierge: version unknown (no $CFG/VERSION)"; exit 1 ;;
  help|--help|-h)
    usage; exit 0 ;;
esac

# Window mode is only ever no args, or nothing but --new / --here. Anything
# else is a mistake — say so before any side effect, rather than open a window.
case "${1-}" in
  snapshot|restore|backup|unread|next|ack) ;;
  *)
    for arg in "$@"; do
      if [[ "$arg" != "--new" && "$arg" != "--here" ]]; then
        print -u2 -r -- "concierge: unknown command '$arg'"
        print -u2 -r -- "usage: concierge [--new] [--here] | <subcommand> … | help"
        exit 2
      fi
    done ;;
esac

# Subcommands run in this terminal and never open a window.
if [[ "${1-}" == "snapshot" ]]; then
  exec "$CFG/snapshot.sh" "${@:2}"
fi
if [[ "${1-}" == "restore" ]]; then
  exec "$CFG/restore.sh" "${@:2}"
fi
if [[ "${1-}" == "backup" ]]; then
  exec "$CFG/backup.sh" "${@:2}"
fi
if [[ "${1-}" == "unread" ]]; then
  exec "$CFG/unread.sh" list "${@:2}"
fi
if [[ "${1-}" == "next" || "${1-}" == "ack" ]]; then
  exec "$CFG/unread.sh" "$@"
fi

for arg in "$@"; do
  [[ "$arg" == "--new" ]] && : > "$CFG/.start-fresh"
done

for arg in "$@"; do
  if [[ "$arg" == "--here" ]]; then
    exec "$CFG/start.sh"
  fi
done

# Open a new iTerm window using the Claude Concierge profile. That profile's
# command is start.sh, so the window comes up already running Claude.
osascript <<'APPLESCRIPT'
tell application "iTerm"
  activate
  create window with profile "Claude Concierge"
end tell
APPLESCRIPT
